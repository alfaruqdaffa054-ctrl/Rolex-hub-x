})

HomeTab:CreateParagraph({
    Title = "Update Logs Luna",
    Content = "• Added 2 new scripts\n• Added new executor"
})

HomeTab:CreateSection("Quick Actions")

-- Rejoin Button
HomeTab:CreateButton({
    Name = "Rejoin Server",
    Callback = function()

        Rayfield:Notify({
            Title = "Rejoining...",
            Content = "Teleporting to same server",
            Duration = 4
        })

        task.wait(1)

        TeleportService:Teleport(game.PlaceId, LocalPlayer)

    end
})

-- Destroy UI
HomeTab:CreateButton({
    Name = "Close UI",
    Callback = function()

        Rayfield:Notify({
            Title = "Goodbye",
            Content = "Closing UI...",
            Duration = 3
        })

        task.wait(1)

        Rayfield:Destroy()

    end
})

