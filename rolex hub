print("[Rolex Hub] Loading Gabungan Clean UI...")

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield', true))()

local Window = Rayfield:CreateWindow({
    Name = "Rolex Hub",
    LoadingTitle = "Rolex Hub",
    LoadingSubtitle = "Gabungan Edition",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "RolexHub",
        FileName = "Config"
    },
    KeySystem = false,
    Theme = "AmberGlow"  -- ganti kalau mau: Default, Ocean, Midnight, dll
})

-- =============================================
-- Tab: Home (Utama)
-- =============================================
local HomeTab = Window:CreateTab("Home", "home")

HomeTab:CreateParagraph({
    Title = "Credits",
    Content = "• rana_GZ77\n• ZREfisch\n• Rayfield Interface Suite\n• Thanks for using Rolex Hub"
})

HomeTab:CreateParagraph({
    Title = "Update Logs",
    Content = "• new selector ui\n• Update fitur ui"
})

HomeTab:CreateSection("Quick Actions")

HomeTab:CreateButton({
    Name = "Rejoin Server",
    Callback = function()
        Rayfield:Notify({
            Title = "Rejoining...",
            Content = "Sedang teleport ke server yang sama...",
            Duration = 4
        })
        task.wait(1)
        game:GetService("TeleportService"):Teleport(game.PlaceId, game.Players.LocalPlayer)
    end
})

HomeTab:CreateButton({
    Name = "Close UI (Destroy Rayfield)",
    Callback = function()
        Rayfield:Notify({
            Title = "Goodbye",
            Content = "UI ditutup...",
            Duration = 3
        })
        task.wait(0.5)
        Rayfield:Destroy()
    end
})

-- =============================================
-- Tab: Choose UI
-- =============================================
local ChooseUITab = Window:CreateTab("Choose UI", "laptop")

ChooseUITab:CreateButton({
    Name = "Rayfield",
    Callback = function()
        Rayfield:Notify({
            Title = "Reloading...",
            Content = "Memuat ulang Rolex Hub (Rayfield)",
            Duration = 3
        })
        task.wait(0.8)
        Rayfield:Destroy()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/alfaruqdaffa054-ctrl/Rolex-hub-x/refs/heads/main/Rolex%20hub", true))()
    end
})

ChooseUITab:CreateButton({
    Name = "Luna",
    Callback = function()
        Rayfield:Notify({
            Title = "Switching...",
            Content = "Memuat Luna UI...",
            Duration = 3
        })
        task.wait(0.8)
        Rayfield:Destroy()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/alfaruqdaffa054-ctrl/Rolex-hub-x/refs/heads/main/Rolex%20hub%20y", true))()
    end
})

